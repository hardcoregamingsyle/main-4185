[debug]

debugging/remote_edit_host=""
debugging/remote_port=3000
debugging/debug_fps_limit=60
debugging/gizmos/show_gizmos=true
debugging/interactive_debugger/show_inspector=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=true
window/size/transparent_viewport=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/fullscreen/initial_mode=true
window/icon="res://icon.svg"

[export]

file_format=5

[export_filter]

filter_type=blacklist
filter_dirs=PackedStringArray(".vs", ".idea", ".git", ".godot")

[external_scenes]

main_menu="res://scenes/main/Main.tscn"

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="obstacles"
3d_physics/layer_1="vehicles"
3d_physics/layer_2="track"
3d_physics/layer_3="colliders"
3d_physics/layer_4="triggers"

[locale]

config_path="res://locales/"
source_string_locale="en"

[editor_plugins]

enabled=PackedStringArray()
disabled=PackedStringArray()

[shader]

mode=default
quality/type="standard"
quality/specular_style="unity"
quality/lighting_model="physically_correct"
quality/use_emission_as_light_source=true
shadow/unfiltered_contact_shadows=true
shadow/contact_shadows=false
shadow/high_resolution_pcf=false
shadow/larger_contact_shadows=true
shadow/larger_penumbra=true
shadow/normal_bias=0.2
shadow/filtering_enabled=true
shadow/filtering_quality=1
shadow/distance_normal_bias_scale=1.0
shadow/distance_far_scale=2.0
shadow/distance_near_scale=1.0
shadow/distance_split_adjustment=0.0
shadow/split_correction=1.0
shadow/reject_occlusion_from_depth_texture=false
shadow/fallback_shadow_map_resolution=2048
shadow/deferred_shadow_rendering=false
shadow/conservative_depth=False
environment/reflection_cubemap_resolution=1024
environment/reflection_cubemap_max_elements=8
environment/reflection_irradiance_resolution=512
environment/reflection_reflections_only=false
