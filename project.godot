[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method_mobile="gl_compatibility"
renderer/rendering_limits/max_bones_per_animation=256
renderer/quality/dither_transparency=false
renderer/limits/vram_compressed_textures=true
renderer/culling/backface_culling=true
renderer/shaders/use_deferred_redraw=true
renderer/environment/default_environment="res://default_env.tres"
renderer/environment/fog/enabled=true
renderer/environment/fog/blend_ratio=0.5
renderer/environment/fog/sky_enabled=true

[physics]

common/physics_ticks_per_second=120
common/substeps_per_frame=4
3d/position_interpolation=true
3d/angular_damping_default=0.1

[shader]

mode/prefer_discard_shaders=false
mode/prefer_glsl3=false
cache/load_mode=load_scripts_and_cache
cache/save_mode=save_scripts_only
shading_language/language=glsl3

[debug]

gdscript/warnings/unreachable_code=true
gdscript/warnings/unused_variable=true
gdscript/warnings/assignment_in_condition=true
gdscript/warnings/inconsistent_indentation=true

[export]

include_pck=true

[export_plugin]

plugin_0="res://addons/thalamus_debugger/plugin.cfg"

[locale]

project/locale_override=""

[performance]

gpu/buffer_sync=false
memory/memory_limit_min=256
memory/memory_limit_max=512
mesh/mesh_merge_enable=true
objects/threaded_animation_import=true

[theme]

theme/custom_theme=""
theme/font_size_base=16
theme/font_antialiasing=true
theme/font_fallback="Noto Sans"

[editor_plugins]

enabled=[
"res://addons/thalamus_debugger/plugin.cfg"
]

[autoload_noinit]

<empty string>=""

[overlay]

show_on_focus_only=false

[protocol]

uri_scheme="thalamus_racing"

[scene_group]

vehicle_physics=["res://vehicles/"]
game_scenes=["res://scenes/gameplay/"]
test_scenes=["res://tests/"]

[vdb]

enabled=false
storage_path="user://vdb_storage"

[world_resources]

use_world_resources=true
max_worlds=8

[dynamic_loading]

enabled=true
priority_scale=1.0

[hot_reload]

enable_hot_reload=true
reload_delay=0.0

[time]

real_time_source="system_clock"
simulate_real_time=true

[debugger]

connection_timeout=30
max_connections=1
remote_host="127.0.0.1"
remote_port=6007

[security]

encryption/allow_encryption=false
security_level="medium"
permission_checking=true

[experimental]

enable_experimental_features=false
enable_experimental_audio=false
enable_experimental_ui=false

[custom_features]

features=[
"4.3-stable",
"forward-plus-renderer",
"godot4-advanced-physics",
"racing-simulator-v1"
]

[build]

target/platform="all"
target/architecture="x86_64"
build_type="release"
strip_symbols=true
optimize_speed=true
optimize_size=false
debug_symbols=false

[packaging]

package_name="ThalamusRacing"
package_identifier="com.thalamus.racing"
package_version="1.0.0"
package_author="Thalamus Team"
package_company="Thalamus Inc."
package_license="MIT"
package_description="Professional Racing Simulation Game"

[ci_cd]

auto_build_on_save=false
auto_export_on_build=true
export_directory="dist"
test_on_each_commit=true

[analytics]

enabled=false
anonymize_data=true
crash_reporting=false

[localization]

source_file_filter="*.csv"
fallback_language="en"
translation_mode="automatic"

[documentation]

generate_docs=true
docs_output_path="docs/generated"
api_reference=true
tutorials_path="res://docs/tutorials/"

[user_data]

save_path="user://saves"
settings_path="user://settings"
log_path="user://logs"
temp_path="user://temp"

[asset_library]

server_url="https://godotengine.org/asset-library/api"
community_assets=true
third_party_repos=[]

[accessibility]

colorblind_mode=false
screen_reader_support=false
high_contrast_mode=false
text_scaling_factor=1.0

[recording]

video_recording_enabled=false
audio_recording_enabled=true
record_fps=60
record_format="mp4"

[streaming]

streaming_enabled=true
streaming_quality="high"
streaming_buffer_ms=500
streaming_priority="low"

[node_paths]

validate_node_paths=true
check_unused_nodes=true
missing_node_behavior="error"

[compatibility]

min_godot_version="4.3"
max_godot_version="4.4"
backward_compatible=true
forward_compatible=true

[dependencies]

required_plugins=[]
optional_plugins=[]
conflicting_plugins=[]

[testing]

test_runner="res://tests/godot_test_runner.tscn"
test_coverage=true
test_parallel_execution=true
test_timeout_seconds=30
test_report_path="reports/test_results.json"

[profiling]

cpu_profiler=true
gpu_profiler=true
memory_profiler=true
profiler_output_path="reports/profiler_output.txt"

[snapshot]

auto_snapshot_before_export=true
snapshot_retention_days=30
snapshot_compression="zstd"

[backup]

auto_backup=true
backup_interval_hours=24
backup_path="backups"
backup_compression="gzip"

[version_control]

preferred_vcs="git"
auto_commit_changes=false
commit_message_template="Auto-commit: {timestamp}"

[deployment]

default_target="web"
deploy_on_save=false
deploy_command=""
post_deploy_script=""

[optimization]

auto_optimize=true
lto_enabled=true
parallel_compilation=true
thread_count=-1

[fps]

target_fps=60
cap_fps=true
vsync_enabled=true
adaptive_fps=false

[ui]

default_font_size=14
default_font_family="Inter"
theme_color_primary="#FF4757"
theme_color_secondary="#2ED573"
theme_color_accent="#1E90FF"
dark_mode_default=true

[audio]

output_driver="default"
mixer_bits_per_sample=32
mixer_channels=2
sample_rate=48000
latency_ms=10
buffer_frames=512

[filesystem]

scan_on_startup=true
watch_for_changes=true
file_system_cache=true
ignore_hidden_files=true

[resources]

preload_safe_load=true
resource_validation=true
lazy_loading=true

[scene_tree]

max_instances=10000
max_children_per_node=1000
instance_pool_size=100

[network]

multiplayer_enabled=false
peer_connection_timeout=5000
reliable_packet_size=1400
unreliable_packet_size=1200
encryption_enabled=true

[platform]

windows/icon="res://icon.ico"
linux/icon="res://icon.png"
macos/icon="res://icon.icns"
android/package_name="com.thalamus.racing"
ios/bundle_identifier="com.thalamus.racing"
web/title="Thalamus Racing Simulator"

[copyright]

year=2026
company="Thalamus Inc."
author="Thalamus Development Team"
license_type="MIT"

[end]