; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Thalamus Racing Simulator"
config/description="Advanced Physics-Based Car Racing Game"
version/version="1.0.0"
version/major=1
version/minor=0
version/patch=0
icon="res://icon.svg"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/preset_name="Default PC"
config/release/exe_icon="res://icon.svg"
config/export/dedicated_server=false

[autoload]

GameManager="*res://scripts/core/GameManager.gd"
AudioManager="*res://scripts/core/AudioManager.gd"
InputManager="*res://scripts/core/InputManager.gd"
PhysicsSettings="*res://scripts/core/PhysicsSettings.gd"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method_debug=true
renderer/rendering_method_max_concurrent_shadows=8
renderer/environment/default_environment="res://default_env.tres"
renderer/shaders/enable_filters=true
renderer/culling/max_cull_distance=1000.0
renderer/culling/min_cull_distance=0.1
renderer/rendering_quality/bits_per_color_channel=8
renderer/rendering_quality/use_vrs=false
renderer/rendering_quality/allow_sparse_textures=true
renderer/rendering_quality/triangle_cull_size=16
renderer/rendering_quality/texture_format_compression_enabled=true

[physics]

common/gravity_3d=(0, -9.81, 0)
common/physics_ticks_per_second=60
common/sleep_threshold_linear=0.001
common/sleep_threshold_angular=0.001
common/default_physics_interpolation=true
common/default_physics_max_substeps=4

