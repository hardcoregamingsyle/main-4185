; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Thalamus Racing Simulator"
config/description="Advanced Physics-Based Car Racing Game"
version/version="1.0.0"
version/major=1
version/minor=0
version/patch=0
icon="res://icon.svg"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/preset_name="Default PC"

[autoload]

GameManager="*res://scripts/core/GameManager.gd"
AudioManager="*res://scripts/core/AudioManager.gd"
InputManager="*res://scripts/core/InputManager.gd"
PhysicsSettings="*res://scripts/core/PhysicsSettings.gd"

[debug]

gdscript/warnings/unused_variable=1
gdscript/warnings/unused_parameter=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":119,"echo":false,"script":null)]
}
move_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":83,"key_label":0,"unicode":115,"echo":false,"script":null)]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65,"key_label":0,"unicode":97,"echo":false,"script":null)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":68,"key_label":0,"unicode":100,"echo":false,"script":null)]
}
brake={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":67,"key_label":0,"unicode":99,"echo":false,"script":null)]
}
accelerate={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":32,"echo":false,"script":null)]
}
handbrake={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":44,"key_label":0,"unicode":44,"echo":false,"script":null)]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":80,"key_label":0,"unicode":112,"echo":false,"script":null)]
}
restart={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":82,"key_label":0,"unicode":114,"echo":false,"script":null)]
}
menu_select={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":340,"key_label":0,"unicode":0,"echo":false,"script":null)]
}
menu_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":341,"key_label":0,"unicode":0,"echo":false,"script":null)]
}
mouse_lock_toggle={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"button_mask":4,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":2,"canceled":false,"pressed":false,"double_click":false,"count":0,"script":null)]
}

[layer_names]

2d_physics=PackedStringArray("player", "vehicles", "obstacles", "world")
3d_physics=PackedStringArray("default", "player", "vehicles", "terrain", "colliders")

[physics]

common/step_hz=60
common/continuous_steps_per_frame=1

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method_profile="high_quality_3d"
renderer/environment/default_environment="res://resources/environments/racing_env.tres"
renderer/canvas_item_use_sdf=true

[shader_cache]

mode="disk"
autoflush=false

[baked_gi]

mode="lightmap"

[occlusion_culling]

enabled=false

[performance]

use_vsync=true
gldebug_check_enabled=false
gl_debug_output=false
delayed_face_culling=true
fps_counter_show_fps=true
low_processor_usage_mode=false

[export]

include_pck=true
filter_denoising=true
split_debugging=false
dump_symbol_names=true
debug/export_console_wrapper=1

[editor_plugins]

enabled=PackedStringArray()

[locale]

translation_files=PackedStringArray()
preferred_locale=""
fallback_locale="en"

[external_scripts]

path=""

[hotreload]

save_before_external_script_editing=true
reload_on_save=true

[assetlib]

import_from_url=false

[editor_settings]

favorite_path="res://"
suggest_all_nodes_on_ready=false
text/edit/font_size=14
text/edit/use_tabs=true
text/edit/show_line_numbers=false
text/edit/show_indentation_guides=true
text/edit/scroll_past_eof=false
filesystem/auto_refresh_enabled=true
filesystem/scan_during_sorting=false
filesystem/folder_filters=PackedStringArray("*.tscn", "*.tres", "*.csproj", "*.sln")
filesystem/import_folders_depth=-1
filesystem/importer_file_batch_update=0
filesystem/import_source_import=false
filesystem/import_source_type="texture"
filesystem/inspectors_first_run=true
filesystem/project_grouping_enabled=true
filesystem/project_groups=[]
