[layer_names]=PackedStringArray("player", "world", "vehicle", "camera", "ui", "effects")

[navigation]

navigation_3d/navigation_server="Default"

[export]

include_empty_dirs=true

[pak]

encryption/search_path=true

[platform]

android={
"features": PackedStringArray("gamersense", "gamepad_support", "vr_ar")
}
ios={
"features": PackedStringArray("gamersense", "gamepad_support")
}
mac={
"features": PackedStringArray("gamersense", "gamepad_support")
}
server={
"features": PackedStringArray("gamersense", "gamepad_support")
}
windows={
"features": PackedStringArray("gamersense", "gamepad_support")
}

[shader]

mode/prefer_gles3=false
mode/revert_to_gles3_on_error=false

[vr]

sdk/openxr_enabled=true
sdk/openxr_layers/Priority/order=0

[subdivision]

enabled=true
max_depth=3

[screenshot]

path="user://screenshot_$YEAR-$MONTH-$DAY_$HOUR-$MINUTE-$SECOND.png"
file_format=PNG

[studio]

remote_debug/host=""
remote_debug/port=3000

[time]

speed_scale=1.0
time_scale=1.0

[debug]

gizmos/show_editable_gizmos_only=false
profiling/run_profiler=false

[locale]

translation/po_files=[]

[editor_plugins]

enabled=PackedStringArray()

[overlay]

debug/text_font_size=10
debug/wireframe_color=Color(0.75, 0.75, 0.75, 1)
debug/show_fps=false
debug/show_overdraw=false
debug/show_collision_shapes=false
debug/show_navigation=false
debug/show_nav_polygons=false
debug/show_nav_obstacles=false
debug/show_nav_nodes=false
debug/show_nav_links=false
debug/show_nav_region=false
debug/show_nav_mesh=false
debug/show_nav_polygon=false
debug/show_nav_obstacle=false
debug/show_nav_node=false
debug/show_nav_link=false
debug/show_nav_region=false

[terrain]

use_threads=true
use_multithreading=true

[vdb]

enabled=false

[drc]

compression_level=5

[monetization]

google_play_store_id=""
app_store_id=""

[performance]

debug/garbage_collection/enabled=true
debug/memory_allocations/enabled=false

[threads]

max_threads=8
default_pool_size_max=8

[rendering]

tiling/enable_cubemap_prefilter=true
tiling/prefilter_resolution=128
tiling/cache_tile_size=64
vrs/use_vrs=false
vrs/compress_compressed_images=true
vrs/compress_compressed_screenshots=false
pipeline/rendering_pipelines_enabled=true
pipeline/custom_pipeline_enables=PoolStringArray("")
pipeline/depth_texture_enabled=true
pipeline/transparent_depth_enabled=true
pipeline/displacement_mapping_enabled=true
pipeline/tessellation_enabled=true
pipeline/screen_space_reflections_enabled=true
pipeline/global_illumination_enabled=true
pipeline/reflection_probe_enabled=true
pipeline/cubemap_enabled=true
pipeline/env_map_enabled=true
pipeline/baked_lightmaps_enabled=true
pipeline/realtime_lightmaps_enabled=true
pipeline/voxelGI_enabled=false
pipeline/fog_enabled=true
pipeline/atmosphere_enabled=true
pipeline/sky_enabled=true
pipeline/caustics_enabled=false
pipeline/refraction_enabled=true
pipeline/transparency_enabled=true
pipeline/shadow_quality/enabled=true
pipeline/shadow_quality/max_distance=500
