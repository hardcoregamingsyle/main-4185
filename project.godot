[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PackedStringArray()

[export]

config/name="Thalamus Racing Simulator"

[export_filter]

filter="exclude_only"
filter_dirs=PackedStringArray("*.import", "*.cache", "*.tmp")

[export_options]

name=""
platforms=PackedStringArray(
	"Windows Desktop",
	"Linux/X11",
	"macOS",
	"Android",
	"iOS",
	"Web"
)

[export_options/Windows Desktop]

architecture="x86_64"
debug/export_console_wrapper=1
binary_format/embed_pck=false
texture_format/bptc=true
texture_format/s3tc=true
texture_format/etc=false
texture_format/etc2=false
binary_format/architecture="x86_64"
encryption/include_filters=PackedStringArray()
encryption/exclude_filters=PackedStringArray()
encryption/key_file=""

[export_options/Linux/X11]

debug/export_console_wrapper=1
binary_format/embed_pck=false
texture_format/bptc=true
texture_format/s3tc=true
texture_format/etc=false
texture_format/etc2=false

[export_options/macOS]

debug/export_console_wrapper=1
binary_format/embed_pck=false
texture_format/bptc=true
texture_format/s3tc=true
texture_format/etc=false
texture_format/etc2=false

[font]

fallbacks=PackedStringArray()

[localization]

locales=PackedStringArray()

[navigation]

navigation_layers=[]

[physics/common]

default_contact_report_collision_layers=1

[subwindows]

show_editor_debug_menus=false

[shader_mode]

mode=1
global_shaders=1

[vdb]

path=""
use_custom_path=false

[visual_shaders]

default_mode=1