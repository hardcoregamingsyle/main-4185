[layer_names]

2d_physics=Physics_2D
3d_physics=Physics_3D

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method/desktop="forward_plus"
renderer/rendering_method/mobile="gl_compatibility"
renderer/caps/max_shadows_per_light=8
renderer/caps/max_interpolated_delta=0.1

[shader]

mode/shader_mode=0
mode/unify_standard=1

[storage]

storage_mode=1
storage/packing/compress_blocks=true
storage/packing/enable_dcc=false
storage/packing/enable_pvr=false
storage/packing/enable_etc=false
storage/packing/enable_etc2=false

[environment]

default_environment/default_env="Environment"
environment/fog_enabled=true
environment/gi_enabled=true
environment/gi_mode=1
environment/atmosphere_enabled=true
environment/background_mode=1
environment/background_sky_material=""
environment/background_color=[color:Color(1, 1, 1, 1)]
environment/environment_diffuse_color=[color:Color(0.5, 0.5, 0.5, 1)]
environment/environment_glow_size=2
environment/environment_glow_level=0.5
environment/environment_fog_type=1
environment/environment_fog_blend_mode=0
environment/environment_fog_depth_far=1000.0
environment/environment_fog_depth_near=0.0
environment/environment_fog_top=1000.0
environment/environment_fog_bottom=0.0
environment/environment_ambient_light_source=0
environment/environment_ambient_light_energy=0.2
environment/environment_ambient_light_color=[color:Color(0.7, 0.7, 0.8, 1)]
environment/environment_ambient_light_sky_color=[color:Color(0.6, 0.7, 0.9, 1)]
environment/environment_sun_direction=[Vector3(-0.5, -0.7, -0.5)]
environment/environment_sun_energy=1.0
environment/environment_sun_color=[color:Color(1, 1, 0.9, 1)]
environment/environment_exposure_scale=10000.0
environment/environment_ambient_light_occlusion=false
environment/environment_ambient_light_diffuse=0.5
environment/environment_ambient_light_specular=0.5

[physics]

common/step_hz=60
common/sleep_threshold=0.01
common/linear_max_velocity=10000.0
common/angular_max_velocity=1000.0
common/allow_integration_fix=true
common/solver_iterations=8
common/solver_velocity_iterations=2
common/solver_position_iterations=1
3d/collision_layer=1
3d/collision_mask=1
3d/collision_layers=1
3d/collision_masks=1
3d/continuous_cd=false
3d/substep_threshold=0.05
3d/triangle_split_size=128
3d/quadrant_size=2048
3d/contact_report_count=256
3d/joint_collision_detection=false

[scene_tree]

node/create_empty_node_on_select=false
node/create_selected_node_on_drag_drop=false
node/use_auto_save=true
node/auto_save_interval=300

