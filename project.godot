;==============================================================================
; Godot Project Configuration File
; Version: 4.3.0-stable
; Description: Cross-platform game project configuration
;==============================================================================

[application]
config/name="Pixel Adventure"
config/description="A cross-platform pixel art adventure game built with Godot 4.3"
config/icon="res://icon.svg"
config/run/main_scene="res://scenes/main.tscn"
config/pack/paths=["res://", "res://assets/"]
config/version={"major":1,"minor":0,"patch":0}
config/recommended_display_scale=1.0
config/use_fullscreen_mode=true
config/vsync_enabled=true
config/features=["GDScript"]

[display]
display/window/size/viewport_width=1920
display/window/size/viewport_height=1080
display/window/resizable=true
display/window/stretch/mode="canvas_items"
display/window/stretch/aspect="keep"
display/fullscreen/enable=false
display/window/sizing_policy="horizontal"
display/window/transparency_support=true
display/window/title="Pixel Adventure v1.0"
display/window/position="centered"

[rendering]
rendering/rendering_method/rendering_driver="vulkan"
rendering/rendering_method/renderer_debug/debug_draw_mode=0
rendering/rendering_method/max_concurrent_shaders=64
rendering/rendering_method/shader_compiler/precompile_shaders=true
rendering/rendering_method/anisotropic_filtering=16
rendering/rendering_method/brightness_and_saturation/brightness=0.0
rendering/rendering_method/brightness_and_saturation/saturation=0.0
rendering/rendering_method/quality/use_3d_line_smoothing=true
rendering/rendering_method/quality/shadows/enabled=true
rendering/rendering_method/environment/default_env/fog_enabled=false
rendering/rendering_method/environment/default_env/background_mode=2

[physics]
physics/common/default_linear_damp=0.1
physics/common/default_angular_damp=0.1
physics/3d/fixed_fps=60
physics/3d/substeps=3
physics/2d/fixed_fps=60
physics/2d/substeps=3

[input]
map/action/jump={"type":"button","code":32}
map/action/move_forward={"type":"key","code":87}
map/action/move_backward={"type":"key","code":83}
map/action/move_left={"type":"key","code":65}
map/action/move_right={"type":"key","code":68}
map/action/crouch={"type":"key","code":16}
map/action/sprint={"type":"key","code":Shift}
map/action/interact={"type":"key","code":E}
map/action/pause={"type":"key","code":Escape}
map/action/screenshot={"type":"key","code":PrintScreen}

[autoload]
GameManager="res://scripts/managers/game_manager.gd"
InputManager="res://scripts/managers/input_manager.gd"
SoundManager="res://scripts/managers/sound_manager.gd"
AssetManager="res://scripts/managers/asset_manager.gd"

[rendering/texture_filters]
filter/2d="linear"
filter/3d="linear"
filter/cubemap="linear"
allow_variants=false

[rendering/anti_aliasing]
anti_aliasing/multisampling/enabled=false
anti_aliasing/multisampling/sample_count=4
anti_aliasing/msaa/3d=disabled
anti_aliasing/msaa/2d=disabled
anti_aliasing/taa/antialiasing_quality=1.0
anti_aliasing/taa/end_fade_distance=1000.0
anti_aliasing/taa/end_fade_far=1000.0
anti_aliasing/taa/end_fade_near=0.0
anti_aliasing/taa/motion_blur_amount=0.0
anti_aliasing/taa/motion_blur_max_steps=64
anti_aliasing/taa/motion_blur_sample_count=8

[rendering/vs]
vs/hlsl_version=160
vs/glsl_version=330

[debug]
debug/gizmos/show_all_gizmos=true
debug/gizmos/default_colors/primitive=Color(0.86, 0.86, 0.86, 1)
debug/gizmos/default_colors/selected=Color(0.28, 0.55, 0.86, 1)
debug/gizmos/default_colors/help=Color(0.86, 0.86, 0.86, 1)
debug/gizmos/default_colors/confirmation=Color(0.28, 0.86, 0.28, 1)

[editor_plugins]
enabled=[]

[shader_cache]
mode="disk"
path="res://.godot/project_metadata.cfg"
version="4.3.0"
</file>