[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method_string="forward_plus"
renderer/rendering_method_mobile="mobile"
renderer/rendering_method_web="gl_compatibility"
renderer/cull/backside=true
renderer/rendering/debugging/wireframe=false
renderer/rendering/debugging/default_color_theme="godot"

[rendering/renderer_features]

forward_plus/deferred_light=true
forward_plus/srgb_transparency=false
forward_plus/timestamps=true

[editor_plugins]

enabled=PackedStringArray()

