[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method_debug/view_mode="wireframe"
renderer/rendering_method_debug/debug_views/background_color=BColor(0, 0, 0, 1)
renderer/rendering_method_debug/debug_views/show_fps=true
renderer/rendering_method_debug/debug_views/show_light_info=false
renderer/rendering_method_debug/debug_views/show_occlusion_culling=false
renderer/rendering_method_debug/debug_views/show_physics_collision_shape=false
renderer/rendering_method_debug/debug_views/show_viewport_as_texture=false
renderer/environment/default_environment/atmosphere_enabled=true
renderer/environment/default_environment/fog_enabled=true
renderer/environment/default_environment/glow_enabled=true
renderer/environment/default_environment/ambient_light_color=BColor(0.2, 0.2, 0.2, 1)
renderer/environment/default_environment/ambient_light_energy=0.5
renderer/environment/default_environment/sky_enabled=true
renderer/environment/default_environment/use_ambient_occlusion=true
renderer/environment/default_environment/use_reflection_probe=true
renderer/rendering_quality/buffer_cache/max_size_mb=256
renderer/rendering_quality/shadows/enabled=true
renderer/rendering_quality/shadows/cascade_count=4
renderer/rendering_quality/shadows/cascade_first_split=0.05
renderer/rendering_quality/shadows/cascade_second_split=0.15
renderer/rendering_quality/shadows/cascade_third_split=0.35
renderer/rendering_quality/shadows/cascade_fourth_split=1.0
renderer/rendering_quality/meshes/instancing_enabled=true
renderer/rendering_quality/meshes/lods_enabled=true
renderer/rendering_quality/meshes/lod_distance_multiplier=1.0
renderer/rendering_quality/textures/compression_quality=0.9
renderer/rendering_quality/textures/filtering_quality=1
renderer/rendering_quality/post_processing/tone_mapping_enabled=true
renderer/rendering_quality/post_processing/bloom_enabled=true
renderer/rendering_quality/post_processing/bloom_threshold=0.5
renderer/rendering_quality/post_processing/bloom_intensity=1.0
renderer/rendering_quality/anti_aliasing/msaa_2d=2
renderer/rendering_quality/anti_aliasing/msaa_3d=4
renderer/rendering_quality/anti_aliasing/anisotropic_filtering=4

[physics]

common/physics_ticks_per_second=120
common/max_substeps=4
common/substep_clamp=true
common/substep_max_clamp=0.1
common/continuous_cd_detection=true
common/optimization_mode=performance

[network]

limits/debugger/connection_timeout=60
limits/debugger/frame_timeout=10

[shader]

cache/always_use_binary=false
cache/enable_read_write_cache=true

[locale]

translations/editor_locale="en"
translations/export_locale="en"

[hot_reload]

auto_save_before_reloading=true
save_external_data_on_reload=true

[script]

language/type_checks/strict_types=false
language/type_checks/type_check_level=1

[export]

include_pck=false
filter_files_only=false
exclude_patterns=PackedStringArray(".git/", ".gitignore", "*.md", "tests/")
use_spaces=false

[platform:Android]

permission/use_permissions_dialog=true

[platform:iOS]

xcode/release/code_sign_identity="iPhone Developer"
xcode/release/provisioning_profile_type="Automatic"
xcode/debug/code_sign_identity="iPhone Developer"
xcode/debug/provisioning_profile_type="Automatic"

[plugins]

disable_all_plugins=true

[editor_plugins]

enabled=PackedStringArray()

[external_scenes]

main_menu.tscn={"path":"res://scenes/main/Main.tscn","instances":PackedStringArray()}

[vdb]

enabled=false

<END>>disabled=PackedStringArray()
