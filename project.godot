; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Thalamus Racing Simulator"
config/description="Advanced Physics-Based Car Racing Game"
version/version="1.0.0"
version/major=1
version/minor=0
version/patch=0
icon="res://icon.svg"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/preset_name="Default PC"

[autoload]

GameManager="*res://scripts/core/GameManager.gd"
AudioManager="*res://scripts/core/AudioManager.gd"
InputManager="*res://scripts/core/InputManager.gd"
PhysicsSettings="*res://scripts/core/PhysicsSettings.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
quality/drivers/rendering_driver/vulkan/enabled=true
quality/features/pipeline_enabled/srgb=true
quality/features/post_processing/bloom_enabled=true
quality/features/shadows/cascaded_shadow_maps_enabled=true
quality/features/shadows/soft_shadows_enabled=true
environment/default_environment="res://assets/environment/default_env.tres"
vrs/use_vrs=false

[physics]

common/physics_ticks_per_second=60
common/3d/default_gravity=Vector3(0, -9.81, 0)
collision/triangle_limit=8
continuous_cd/disable_ccd_when_not_colliding=true

[physics_3d]

stepper/substep_splitting=true
stepper/adaptive_substeps=true
stepper/max_steps=4
stepper/adaptive_threshold=0.1

