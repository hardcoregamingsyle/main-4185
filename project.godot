; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Thalamus Racing Simulator"
config/description="Advanced Physics-Based Car Racing Game"
version/version="1.0.0"
version/major=1
version/minor=0
version/patch=0
icon="res://icon.svg"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/preset_name="Default PC"

[autoload]

GameManager="*res://scripts/core/GameManager.gd"
AudioManager="*res://scripts/core/AudioManager.gd"
InputManager="*res://scripts/core/InputManager.gd"
PhysicsSettings="*res://scripts/core/PhysicsSettings.gd"

[rendering]

quality/driver_name="Vulkan"
quality/use_desktop_gl=true
vsync/enable=false
environment/default_environment="res://environments/default.tres"

[input_map]

move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65362,"key_label":0,"unicode":0,"echo":false,"script":null)]
}
move_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65364,"key_label":0,"unicode":0,"echo":false,"script":null)]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65361,"key_label":0,"unicode":0,"echo":false,"script":null)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65363,"key_label":0,"unicode":0,"echo":false,"script":null)]
}
brake={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65365,"key_label":0,"unicode":0,"echo":false,"script":null)]
}
accelerate={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65362,"key_label":0,"unicode":0,"echo":false,"script":null)]
}
horn={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65,"key_label":0,"unicode":97,"echo":false,"script":null)]
}
pause_game={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65307,"key_label":0,"unicode":0,"echo":false,"script":null)]
}

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect_expand=0.0
window/full_screen/exclusive_width=1920
window/full_screen/exclusive_height=1080
window/msaa=2

[physics]

common/physics_tick_rate=120
common/max_substeps=4
3d/angular_damping=0.05
3d/default_angular_damp=0.05
3d/default_linear_damp=0.0

[shader]

cache/entry_count=1000
cache/entry_count_fast=100

[network]

limits/streamer_max_clients=100

[debug]

gdscript/warnings/unused_variable=false
gdscript/warnings/shadowed_variable=false
profiling/show_fps=true

[editor_plugins]

enabled=PackedStringArray("res://addons/thalamus_editor_plugin/plugin.cfg")

[export]

include_all_scenes=true
include_all_resources=true
exclude_type=3

[export_plugin]

plugins/PCKPacker/export_plugin=1

[layout]

dock/2/split=0.5
dock/4/split=0.5
panels/dock_0=hidden
panels/dock_1=hidden
panels/dock_2=hidden
panels/dock_3=hidden

[editor_settings]

suggest_full_snippets=false
use_internal_font=false
auto_translate_mode=0
edit/display_collapsed_nodes=true
edit/navigation/editable_children_only=false
time_scale/time_scale_snap=0.1
text_edit/scroll_past_eof=false
filesystem/watch_delay=2.0
filesystem/file_size_limit_mb=1000
filesystem/import/texture_compression=2
filesystem/import/texture_flags=0
filesystem/import/texture_mipmaps=false
filesystem/import/texture_srgb_enabled=true
filesystem/import/texture_generate_mipmaps=true
filesystem/import/texture_anisotropic_filtering=4
filesystem/import/texture_import_source_format=0
filesystem/import/texture_override_size=Vector2(0, 0)
filesystem/import/texture_reimport_on_changes=false
filesystem/import/texture_reimport_on_resource_change=false
filesystem/import/texture_reimport_on_scene_change=false
filesystem/import/texture_reimport_on_script_change=false
filesystem/import/texture_reimport_on_texture_change=false
filesystem/import/texture_reimport_on_material_change=false
filesystem/import/texture_reimport_on_animation_change=false
filesystem/import/texture_reimport_on_shader_change=false
filesystem/import/texture_reimport_on_project_settings_change=false
filesystem/import/texture_reimport_on_export_change=false
filesystem/import/texture_reimport_on_platform_change=false
filesystem/import/texture_reimport_on_configuration_profile_change=false
filesystem/import/texture_reimport_on_theme_change=false
filesystem/import/texture_reimport_on_stylebox_change=false
filesystem/import/texture_reimport_on_colorchange=false
filesystem/import/texture_reimport_on_font_change=false
filesystem/import/texture_reimport_on_outline_change=false
filesystem/import/texture_reimport_on_preview_change=false
filesystem/import/texture_reimport_on_cache_change=false
filesystem/import/texture_reimport_on_metadata_change=false
filesystem/import/texture_reimport_on_custom_change=false

