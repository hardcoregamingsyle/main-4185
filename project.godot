[rendering]

renderer/rendering_method="forward_plus"
quality/drivers/rendering_driver/vulkan/enabled=true
quality/features/pipeline_enabled/srgb=true
quality/features/post_processing/bloom_enabled=true
quality/features/shadows/cascaded_shadow_maps_enabled=true
quality/features/shadows/soft_shadows_enabled=true
environment/default_environment="res://assets/environment/default_env.tres"
vrs/use_vrs=false
shaders/reject_unsupported_shaders=false
glsl_version/glsl_330=true
glsl_version/glsl_450=true

[physics]

common/physics_ticks_per_second=120
common/3d/default_gravity=Vector3(0, -9.81, 0)
collision/triangle_limit=8
continuous_cd/disable_ccd_when_not_colliding=true
common/max_steps=4
common/max_step_delta=0.1

[physics_3d]

stepper/substep_splitting=true
stepper/adaptive_substeps=true
stepper/max_steps=4
stepper/adaptive_threshold=0.1
stepper/adaptive_divisor=1

[export]

include_filter=["*.gd","*.tscn","*.tres","*.svg","*.png","*.jpg","*.ogg","*.mp3"]
exclude_filter=["*.bak","*.tmp","*.gitignore"]

[export_plugins]

editor_plugins_enabled=PackedStringArray()

[gui]

theme/theme_override/styles/StyleBoxFlat/background_color=Color(0.15, 0.15, 0.15, 1)
theme/theme_override/colors/button_text_color=Color(1, 1, 1, 1)
theme/theme_override/colors/title_color=Color(0.2, 0.6, 1, 1)

[shader]

feature/profile="high_end_pc"

[monitors]

monitor/filter=""
monitor/display_mode=0
monitor/refresh_rate=60

[debug]

gdb/connect_profile_url="tcp://localhost:37026"
profiling/startup_profiling=false
profile_release=false

[drawing]

debug/show_overdraw=false
debug/show_collision_layers=false
debug/gizmos=true

[locale]

translated_strings/PackedStringArray("")

[platform]

android/apk_compression=1
android/min_sdk=23
android/target_sdk=33
android/one_signing_profile=true
ios/code_signing_identity="iPhone Developer"
ios/provisioning_profile_uuid=""
ios/export/architectures="arm64"
macos/export/icon=""
macos/signing_identity=""
web/browser/url/host="localhost"
web/browser/url/port=8080
windows/console_debugging=false
windows/code_signing_enabled=false
windows/code_signing_timestamp_url="http://timestamp.digicert.com"
windows/code_signing_certificate=""
windows/code_signing_crl_url=""
windows/code_signing_intermediate_certs=false
windows/export/filters="*.png;*.jpg;*.jpeg;*.ogg;*.wav;*.mp3;*.ttf;*.pdf;*.json;*.xml;*.html;*.txt;*.md;*.cfg;*.ini;*.conf;*.cfg;*.lock;*.log"
windows/export/include_sources=true
windows/export/include_scripts=true
windows/export/debug/export_on_save=false
windows/export/release/debugger=false
windows/export/release/threaded_export=false

[[options]]

debug/debugging_mode=1
export/path="C:/Users/User/Desktop/Thalamus_Racing.exe"
export/format=0
export/filter="all_excluding_scenes"
export/type=0

[[options]]

debug/debugging_mode=1
export/path="C:/Users/User/Desktop/Thalamus_Racing_Desktop.exe"
export/format=0
export/filter="all_excluding_scenes"
export/type=0
</export>
</File>
