; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

[application]

config/name="Thalamus Racing Simulator"
config/description="Advanced Physics-Based Car Racing Game"
version/version="1.0.0"
version/major=1
version/minor=0
version/patch=0
icon="res://icon.svg"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/preset_name="Default PC"
config/release/exe_icon="res://icon.svg"
config/export/dedicated_server=false
config/settings/messaging/on_connect="Disabled"
config/settings/messaging/on_state_change="Disabled"
config/features/debug=true

[autoload]

GameManager="*res://scripts/core/GameManager.gd"
AudioManager="*res://scripts/core/AudioManager.gd"
InputManager="*res://scripts/core/InputManager.gd"
PhysicsSettings="*res://scripts/core/PhysicsSettings.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_left={
"deadzone": 0.5,
