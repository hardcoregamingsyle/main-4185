# Thalamus Racing Simulator - EditorConfig
# Ensures consistent code formatting across all editors and IDEs
# Copyright 2026 Thalamus Racing Simulator Project

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.gd]
# GDScript specific settings
indent_size = 4
tab_width = 4

[*.tscn]
# Scene files
indent_size = 2

[*.cfg]
# Configuration files
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
# Markdown files
trim_trailing_whitespace = false

[*.json]
# JSON files
indent_size = 2

[*.svg]
# Vector graphics
indent_size = 2