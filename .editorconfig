# EditorConfig - Consistent formatting for Thalamus Racing Simulator
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
final_newline = true

[*.gd]
# GDScript specific settings
indent_size = 2
tab_width = 2
max_line_length = 0  # No hard limit for GDScript

[*.tscn]
# Godot scene files
indent_size = 2

[*.cfg]
# Godot config files
indent_size = 2

[Makefile]
indent_style = tab

[*.json]
indent_style = space
indent_size = 2

[*.xml]
indent_style = space
indent_size = 2

[*.{svg,png,jpg,jpeg,gif,webp}]
binary = true

[*.{md,rst,tex}]
trim_trailing_whitespace = false